{
  "name": "@mininglamp-oss/octo-runtime-daemon-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "octo-runtime-daemon": "dist/launcher.js"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./runtime-options": {
      "types": "./dist/runtime-options.d.ts",
      "import": "./dist/runtime-options.js"
    },
    "./openclaw": {
      "types": "./dist/openclaw.d.ts",
      "import": "./dist/openclaw.js"
    }
  },
  "scripts": {
    "start": "node dist/launcher.js",
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').chmodSync('dist/launcher.js', 0o755)\""
  },
  "dependencies": {
    "@mininglamp-oss/octo-runtime-adapter-sdk": "workspace:*",
    "@mininglamp-oss/octo-runtime-extra-channel-gateway": "workspace:*",
    "@mininglamp-oss/octo-runtime-adapter-openclaw": "workspace:*",
    "json5": "2.2.3",
    "@mininglamp-oss/octo-runtime-adapter-host": "workspace:*",
    "@mininglamp-oss/octo-runtime-daemon": "workspace:*",
    "@mininglamp-oss/octo-runtime-protocol": "workspace:*"
  },
  "types": "./dist/server.d.ts"
}
