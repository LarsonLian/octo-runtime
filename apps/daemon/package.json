{
  "name": "@mininglamp-oss/octo-harness-daemon-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "octo-harness-daemon": "dist/launcher.js"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./runtime-options": {
      "types": "./dist/runtime-options.d.ts",
      "import": "./dist/runtime-options.js"
    }
  },
  "scripts": {
    "start": "node dist/launcher.js",
    "build": "tsc -p tsconfig.json && chmod +x dist/launcher.js"
  },
  "dependencies": {
    "@mininglamp-oss/octo-harness-adapter-host": "workspace:*",
    "@mininglamp-oss/octo-harness-core": "workspace:*",
    "@mininglamp-oss/octo-harness-daemon": "workspace:*",
    "@mininglamp-oss/octo-harness-protocol": "workspace:*",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1"
  },
  "types": "./dist/server.d.ts"
}
