  {
    "name": "model-reasoning-inherits-selection",
    "configuration": {
      "defaults": {
        "schema": "octo.context-envelope/v3",
        "items": [
          {
            "namespace": "octo.execution",
            "name": "model",
            "payload": {
              "selection": {
                "id": "default-model"
              },
              "reasoning": {
                "effort": "low"
              }
            }
          }
        ]
      },
      "mandatory": {
        "schema": "octo.context-envelope/v3",
        "items": []
      }
    },
    "request": {
      "schema": "octo.context-envelope/v3",
      "items": [
        {
          "namespace": "octo.execution",
          "name": "model",
          "payload": {
            "reasoning": {
              "effort": "high"
            }
          }
        }
      ]
    },
    "expected": {
      "schema": "octo.context-envelope/v3",
      "items": [
        {
          "namespace": "octo.execution",
          "name": "model",
          "payload": {
            "selection": {
              "id": "default-model"
            },
            "reasoning": {
              "effort": "high"
            }
          }
        }
      ]
    }
  },
