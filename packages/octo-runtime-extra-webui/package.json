{
  "name": "@mininglamp-oss/octo-runtime-extra-webui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local Runtime workbench with canonical SSE presentation",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config-schema.json": "./config-schema.json"
  },
  "files": [
    "dist",
    "config-schema.json",
    "README.md",
    "porting-map.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p web/tsconfig.json && vite build --config vite.config.ts",
    "test:ui": "vitest run --config vite.config.ts"
  },
  "dependencies": {
    "@mininglamp-oss/octo-runtime-protocol": "workspace:*"
  },
  "devDependencies": {
    "@mininglamp-oss/octo-runtime-daemon": "workspace:*",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "lucide-react": "^0.542.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "clsx": "^2.1.1",
    "shell-quote": "^1.8.3",
    "eventsource-parser": "^4.1.2",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/shell-quote": "^1.7.5",
    "vite": "^8.0.0",
    "sass": "^1.104.1",
    "vitest": "^4.0.15",
    "happy-dom": "^20.8.9"
  }
}
