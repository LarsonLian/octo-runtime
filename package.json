{
  "name": "@mininglamp-oss/octo-harness",
  "version": "0.1.1",
  "private": false,
  "description": "Provider-neutral Harness runtime for unified AgentSession and AgentRun execution",
  "type": "module",
  "bin": {
    "octo-harness": "apps/cli/dist/index.js",
    "octo-harness-daemon": "apps/daemon/dist/launcher.js"
  },
  "files": [
    "apps/adapter-host/dist",
    "apps/cli/dist",
    "apps/cli/README.md",
    "apps/daemon/dist",
    "config/adapters.json",
    "DEPLOYMENTS.md"
  ],
  "packageManager": "pnpm@11.19.0",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@codex.mlamp.cn/dmwork/octo-harness/octo-harness.git"
  },
  "scripts": {
    "test": "pnpm build && node --test",
    "cli": "pnpm build && node apps/cli/dist/index.js",
    "daemon": "pnpm build && node apps/daemon/dist/launcher.js",
    "host": "pnpm build && node apps/adapter-host/dist/index.js --manifest config/adapters.json",
    "build": "pnpm --recursive --filter \"./packages/**\" --filter \"./apps/**\" run build",
    "prepare": "pnpm run build",
    "typecheck": "pnpm build && tsc -p tsconfig.json --noEmit",
    "lint": "eslint apps packages"
  },
  "dependencies": {
    "@mininglamp-oss/octo-harness-adapter-acp": "0.1.0",
    "@mininglamp-oss/octo-harness-adapter-claude-code": "^0.1.0",
    "@mininglamp-oss/octo-harness-adapter-codebuddy": "^0.1.0",
    "@mininglamp-oss/octo-harness-adapter-codex": "^0.1.0",
    "@mininglamp-oss/octo-harness-adapter-hermes": "^0.1.0",
    "@mininglamp-oss/octo-harness-adapter-host": "0.1.1",
    "@mininglamp-oss/octo-harness-adapter-kimi-code": "^0.1.0",
    "@mininglamp-oss/octo-harness-adapter-kiro": "^0.1.0",
    "@mininglamp-oss/octo-harness-adapter-openclaw": "^0.1.0",
    "@mininglamp-oss/octo-harness-adapter-opencode": "^0.1.0",
    "@mininglamp-oss/octo-harness-core": "0.1.1",
    "@mininglamp-oss/octo-harness-cross-service": "0.1.1",
    "@mininglamp-oss/octo-harness-daemon": "0.1.1",
    "@mininglamp-oss/octo-harness-observability": "0.1.1",
    "@mininglamp-oss/octo-harness-protocol": "0.1.1",
    "commander": "^15.0.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@eslint/js": "^10.0.1",
    "@mininglamp-oss/octo-harness-acp-client": "0.1.0",
    "@mininglamp-oss/octo-harness-daemon-app": "0.1.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.9.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  }
}
