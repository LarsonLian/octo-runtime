{
  "name": "@mininglamp-oss/octo-harness",
  "version": "0.1.0",
  "private": false,
  "description": "Provider-neutral Harness runtime for unified AgentSession and AgentRun execution",
  "type": "module",
  "bin": {
    "octo-harness": "apps/cli/dist/index.js",
    "octo-harness-daemon": "apps/daemon/dist/launcher.js"
  },
  "files": [
    "apps/adapter-host/dist/**/*.js",
    "apps/cli/dist/**/*.js",
    "apps/cli/README.md",
    "apps/daemon/dist/**/*.js",
    "config/adapters.json",
    "DEPLOYMENTS.md"
  ],
  "packageManager": "pnpm@11.19.0",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@codex.mlamp.cn/dmwork/octo-harness/octo-harness.git"
  },
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "prebuild": "pnpm run clean",
    "test": "pnpm build && node --test test/*.test.js packages/octo-harness-protocol/test/*.test.js",
    "cli": "pnpm build && node apps/cli/dist/index.js",
    "daemon": "pnpm build && node apps/daemon/dist/launcher.js",
    "host": "pnpm build && node apps/adapter-host/dist/index.js --manifest config/adapters.json",
    "build": "pnpm --recursive --filter \"./packages/**\" --filter \"./apps/**\" run build",
    "prepare": "pnpm run build",
    "typecheck": "pnpm build && tsc -p tsconfig.json --noEmit",
    "lint": "eslint apps packages"
  },
  "dependencies": {
    "@mininglamp-oss/octo-harness-adapter-antigravity": "workspace:*",
    "@mininglamp-oss/octo-harness-adapter-claude-code": "workspace:*",
    "@mininglamp-oss/octo-harness-adapter-acp": "workspace:*",
    "@mininglamp-oss/octo-harness-adapter-codebuddy": "workspace:*",
    "@mininglamp-oss/octo-harness-adapter-codex": "workspace:*",
    "@mininglamp-oss/octo-harness-adapter-hermes": "workspace:*",
    "@mininglamp-oss/octo-harness-adapter-icons": "workspace:*",
    "@mininglamp-oss/octo-harness-adapter-kimi-code": "workspace:*",
    "@mininglamp-oss/octo-harness-adapter-host": "workspace:*",
    "@mininglamp-oss/octo-harness-adapter-mcode": "workspace:*",
    "@mininglamp-oss/octo-harness-adapter-openclaw": "workspace:*",
    "@mininglamp-oss/octo-harness-adapter-opencode": "workspace:*",
    "@mininglamp-oss/octo-harness-adapter-qodercli": "workspace:*",
    "@mininglamp-oss/octo-harness-adapter-qoderclicn": "workspace:*",
    "@mininglamp-oss/octo-harness-adapter-zcode-gui": "workspace:*",
    "@mininglamp-oss/octo-harness-core": "workspace:*",
    "@mininglamp-oss/octo-harness-cross-service": "workspace:*",
    "@mininglamp-oss/octo-harness-daemon": "workspace:*",
    "@mininglamp-oss/octo-harness-protocol": "workspace:*",
    "ws": "^8.18.3",
    "@mininglamp-oss/octo-harness-worker-access": "workspace:*",
    "@mininglamp-oss/octo-harness-context-builder": "workspace:*",
    "@mininglamp-oss/octo-harness-im": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mininglamp-oss/octo-harness-acp-client": "workspace:*",
    "@mininglamp-oss/octo-harness-daemon-app": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "^10.9.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  }
}
