{
  "name": "orbtex",
  "version": "0.1.0",
  "private": true,
  "description": "Provider-neutral agent harness runtime for chat, task and trigger workflows",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orbtex-ai/orbtex.git"
  },
  "scripts": {
    "test": "pnpm build && node --test",
    "demo": "pnpm build && node apps/example-basic/dist/index.js",
    "cli": "pnpm build && node apps/cli/dist/index.js",
    "daemon": "pnpm build && node apps/daemon/dist/index.js",
    "host": "pnpm build && node apps/adapter-host/dist/index.js --manifest config/adapters.json",
    "build": "pnpm --recursive --filter \"./packages/**\" --filter \"./apps/**\" run build",
    "typecheck": "pnpm build && tsc -p tsconfig.json --noEmit",
    "lint": "eslint apps packages"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@orbtex-ai/orbtex-acp-client": "workspace:*",
    "@orbtex-ai/orbtex-adapter-claude-code": "workspace:*",
    "@orbtex-ai/orbtex-adapter-codebuddy": "workspace:*",
    "@orbtex-ai/orbtex-adapter-codex": "workspace:*",
    "@orbtex-ai/orbtex-adapter-host": "workspace:*",
    "@orbtex-ai/orbtex-adapter-openclaw": "workspace:*",
    "@orbtex-ai/orbtex-adapter-opencode": "workspace:*",
    "@orbtex-ai/orbtex-core": "workspace:*",
    "@orbtex-ai/orbtex-daemon": "workspace:*",
    "@orbtex-ai/daemon-app": "workspace:*",
    "@types/node": "^20.19.43",
    "eslint": "^10.9.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=11"
  }
}
